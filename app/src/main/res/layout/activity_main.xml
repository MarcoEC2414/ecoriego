<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="@color/eco_bg" android:layout_width="match_parent" android:layout_height="match_parent">
 <ScrollView android:fillViewport="true" android:layout_width="match_parent" android:layout_height="match_parent">
  <LinearLayout android:orientation="vertical" android:paddingBottom="28dp" android:layout_width="match_parent" android:layout_height="wrap_content">
   <LinearLayout android:background="@drawable/bg_header" android:orientation="vertical" android:padding="24dp" android:paddingTop="28dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content"><TextView android:text="EcoRiego" android:textColor="@android:color/white" android:textSize="28sp" android:textStyle="bold" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/><TextView android:text="HUERTO" android:textColor="@android:color/white" android:alpha=".75" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout>
    <TextView android:id="@+id/tvSaludo" android:text="Tu huerto, un día a la vez." android:textColor="@android:color/white" android:alpha=".9" android:textSize="15sp" android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <LinearLayout android:background="#33FFFFFF" android:padding="16dp" android:orientation="vertical" android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"><TextView android:text="CLIMA ACTUAL" android:textColor="@android:color/white" android:textSize="11sp" android:textStyle="bold" android:alpha=".8" android:layout_width="match_parent" android:layout_height="wrap_content"/><LinearLayout android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content"><TextView android:id="@+id/tvTemp" android:text="--°C" android:textColor="@android:color/white" android:textSize="30sp" android:textStyle="bold" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/><TextView android:id="@+id/tvRain" android:text="Consultando…" android:textColor="@android:color/white" android:textSize="14sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout><TextView android:id="@+id/tvWeatherStatus" android:text="Conectando con Open-Meteo" android:textColor="@android:color/white" android:alpha=".9" android:layout_width="match_parent" android:layout_height="wrap_content"/></LinearLayout>
   </LinearLayout>
   <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:padding="20dp" android:paddingBottom="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"><TextView android:text="Mis plantas" android:textColor="@color/eco_text" android:textSize="22sp" android:textStyle="bold" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/><Button android:id="@+id/btnNueva" android:text="+ Añadir" android:textColor="@android:color/white" android:background="@drawable/bg_button" android:textAllCaps="false" android:paddingLeft="16dp" android:paddingRight="16dp" android:layout_width="wrap_content" android:layout_height="48dp"/></LinearLayout>
   <TextView android:id="@+id/tvResumen" android:text="0 plantas" android:textColor="@color/eco_muted" android:paddingLeft="20dp" android:paddingBottom="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
   <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerPlantas" android:paddingLeft="16dp" android:paddingRight="16dp" android:clipToPadding="false" android:nestedScrollingEnabled="false" android:layout_width="match_parent" android:layout_height="wrap_content"/>
   <Button android:id="@+id/btnReportes" android:text="Ver reportes y estadísticas  ›" android:textColor="@color/eco_green" android:textAllCaps="false" android:background="@drawable/bg_outline" android:layout_margin="20dp" android:layout_width="match_parent" android:layout_height="50dp"/>
  </LinearLayout>
 </ScrollView>
</LinearLayout>
