<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:background="@color/eco_bg" android:fillViewport="true" android:layout_width="match_parent" android:layout_height="match_parent"><LinearLayout android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"><TextView android:id="@+id/tvFormTitle" android:text="Nueva planta" android:textColor="@color/eco_text" android:textSize="28sp" android:textStyle="bold" android:layout_marginBottom="6dp" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:text="Completa los datos para personalizar el cuidado." android:textColor="@color/eco_muted" android:layout_marginBottom="24dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="Nombre de la planta" android:textStyle="bold" android:textColor="@color/eco_text"/><EditText android:id="@+id/etNombre" android:hint="Ej. Albahaca" android:inputType="textCapSentences" android:background="@drawable/bg_input" android:layout_marginTop="7dp" android:layout_marginBottom="16dp" android:layout_width="match_parent" android:layout_height="54dp"/>
<TextView android:text="Especie" android:textStyle="bold" android:textColor="@color/eco_text"/><EditText android:id="@+id/etEspecie" android:hint="Ej. Ocimum basilicum" android:inputType="textCapSentences" android:background="@drawable/bg_input" android:layout_marginTop="7dp" android:layout_marginBottom="16dp" android:layout_width="match_parent" android:layout_height="54dp"/>
<TextView android:text="Fecha de siembra (AAAA-MM-DD)" android:textStyle="bold" android:textColor="@color/eco_text"/><EditText android:id="@+id/etFecha" android:hint="2026-09-18" android:inputType="date" android:background="@drawable/bg_input" android:layout_marginTop="7dp" android:layout_marginBottom="16dp" android:layout_width="match_parent" android:layout_height="54dp"/>
<TextView android:text="Frecuencia de riego (días)" android:textStyle="bold" android:textColor="@color/eco_text"/><EditText android:id="@+id/etFrecuencia" android:hint="Ej. 3" android:inputType="number" android:background="@drawable/bg_input" android:layout_marginTop="7dp" android:layout_marginBottom="16dp" android:layout_width="match_parent" android:layout_height="54dp"/>
<TextView android:text="Ubicación" android:textStyle="bold" android:textColor="@color/eco_text"/><Spinner android:id="@+id/spUbicacion" android:background="@drawable/bg_input" android:layout_marginTop="7dp" android:layout_marginBottom="16dp" android:layout_width="match_parent" android:layout_height="54dp"/>
<TextView android:text="Notas" android:textStyle="bold" android:textColor="@color/eco_text"/><EditText android:id="@+id/etNotas" android:hint="Luz, cuidados especiales, observaciones…" android:gravity="top" android:inputType="textCapSentences|textMultiLine" android:background="@drawable/bg_input" android:padding="14dp" android:minLines="4" android:layout_marginTop="7dp" android:layout_marginBottom="24dp" android:layout_width="match_parent" android:layout_height="110dp"/>
<Button android:id="@+id/btnGuardar" android:text="Guardar planta" android:textColor="@android:color/white" android:textAllCaps="false" android:textStyle="bold" android:background="@drawable/bg_button" android:layout_width="match_parent" android:layout_height="54dp"/>
</LinearLayout></ScrollView>
